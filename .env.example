# Copy to .env and edit:  cp .env.example .env
EULA=false                # set true to accept https://aka.ms/MinecraftEULA

# Choose what to run. Find valid values with:
#   docker compose run --rm minecraft mcctl mc                       (Minecraft versions)
#   docker compose run --rm minecraft mcctl loaders neoforge         (MC versions a loader supports)
#   docker compose run --rm minecraft mcctl loader neoforge 1.21.1   (loader versions for an MC version)
MC_VERSION=1.21.1         # exact version, "latest" or "latest-snapshot"
LOADER=neoforge           # vanilla | fabric | forge | neoforge
LOADER_VERSION=           # empty = recommended (Forge) / newest stable (others); or e.g. 21.1.172

MEMORY=4G
#MEMORY_MIN=2G            # default: same as MEMORY
#JVM_OPTS=-XX:+UseG1GC    # extra JVM flags
#UPDATE=true              # re-resolve "latest"/empty LOADER_VERSION on next start (then set back to false)

HOST_PORT=25565
PUID=1000
PGID=1000
