# Copy to .env and edit:  cp .env.example .env
EULA=false                # set true to accept https://aka.ms/MinecraftEULA

# Choose what to run. Find valid values with:
#   docker compose run --rm minecraft mcctl mc                       (Minecraft versions)
#   docker compose run --rm minecraft mcctl loaders neoforge         (MC versions a loader supports)
#   docker compose run --rm minecraft mcctl loader neoforge 1.21.1   (loader versions for an MC version)
MC_VERSION=1.21.1         # exact version, "latest" or "latest-snapshot"
LOADER=neoforge           # vanilla | fabric | forge | neoforge
LOADER_VERSION=           # empty = recommended (Forge) / newest stable (others); or e.g. 21.1.172

MEMORY=4G
#MEMORY_MIN=2G            # default: same as MEMORY
#JVM_OPTS=-XX:+UseG1GC    # extra JVM flags
#UPDATE=true              # re-resolve "latest"/empty LOADER_VERSION on next start (then set back to false)

# Port the server listens on (written to server.properties, also the published port)
SERVER_PORT=25565

# Operators (admins), comma separated Minecraft usernames. Added to ops.json on start.
# Only adds: ops given in-game are kept, and removing a name here does not de-op it (use /deop).
#OPS=Notch,jeb_
#OP_LEVEL=4               # 1-4, applies to newly added operators

# Paths (inside the server folder) that are kept in a separate folder which survives
# reinstalls and "docker compose down" + deleting ./data. Comma separated, e.g.:
#PERSIST=world,ops.json,whitelist.json,banned-players.json,server.properties
#PERSIST_HOST_DIR=./persist   # where on the host; can be any path, e.g. /srv/minecraft-keep

#IMAGE=ghcr.io/merpzz/minecraft-docker:latest   # or pin e.g. ...:sha-abc1234
PUID=1000
PGID=1000
